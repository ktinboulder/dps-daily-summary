# ─────────────────────────────────────────────────────────
#  DPS Daily School Summary — Credential Configuration
#  Copy this file to ".env" and fill in your values.
#  Keep .env private — never share or commit it.
# ─────────────────────────────────────────────────────────

# ── DPS Infinite Campus Login ─────────────────────────────
# Your parent/guardian portal username and password
DPS_USERNAME=your_ic_username_here
DPS_PASSWORD=your_ic_password_here

# ── Gmail Settings ────────────────────────────────────────
# The Gmail account that SENDS the summary email.
# Use a Gmail App Password (NOT your main Gmail password).
#
# How to create an App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already on
#   3. Search "App passwords" → create one for "Mail"
#   4. Paste the 16-character code below (no spaces)
GMAIL_EMAIL=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Summary Recipients ────────────────────────────────────
# Where the daily emails should be delivered (comma-separated for multiple)
RECIPIENT_EMAIL=you@gmail.com

# ── Students ──────────────────────────────────────────────
# Add one block per student. Numbering must start at 1 and be consecutive.
#
# STUDENT_N_NAME        : display name used in the email subject and header
# STUDENT_N_TARGET_NAME : full name as it appears in the portal (used to
#                         select the correct student on multi-student accounts)
# STUDENT_N_SCHOOL      : school name shown in the email header
# STUDENT_N_GRADE       : grade number shown in the email header (e.g. 10)
# STUDENT_N_RECIPIENTS  : (optional) extra recipients for this student's email,
#                         comma-separated; merged with RECIPIENT_EMAIL above

STUDENT_1_NAME=Will Taylor
STUDENT_1_TARGET_NAME=William B. Taylor
STUDENT_1_SCHOOL=Denver School of Arts HS
STUDENT_1_GRADE=10

STUDENT_2_NAME=Kathryn Taylor
STUDENT_2_TARGET_NAME=Kathryn R. Taylor
STUDENT_2_SCHOOL=Northfield HS
STUDENT_2_GRADE=12
STUDENT_2_RECIPIENTS=krtindenver@icloud.com
